# ─────────────────────────────────────────────────────────────
# Same SPA build as apps/web/Dockerfile, served by nginx instead of Caddy.
# Used only via docker-compose.nginx.yml — see infra/nginx/nginx.conf for the
# differences that matter (no automatic TLS, explicit WebSocket upgrades).
# ─────────────────────────────────────────────────────────────
FROM node:22-alpine AS build
RUN corepack enable
WORKDIR /app
# Every workspace manifest has to be present for pnpm to validate the lockfile,
# even though only @pulse/web is installed and built here.
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml ./
COPY packages/core/package.json packages/core/
COPY apps/api/package.json apps/api/
COPY apps/ingest/package.json apps/ingest/
COPY apps/simulator/package.json apps/simulator/
COPY apps/web/package.json apps/web/
RUN pnpm install --frozen-lockfile --filter "@pulse/web"
COPY apps/web ./apps/web
RUN pnpm --filter @pulse/web build

FROM nginx:1.27-alpine AS runtime
COPY --from=build /app/apps/web/dist /srv
# Replaces nginx.conf wholesale rather than dropping a file into conf.d/,
# because the `map` that drives WebSocket upgrades is only valid in the http
# context. Without it the live dashboard and the device WS uplink both break.
COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf
# Fail the build rather than the deployment if the config is malformed.
RUN nginx -t
