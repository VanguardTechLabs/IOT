# ─────────────────────────────────────────────────────────────
# Pulse IoT — environment
# Copy to `.env` and change every secret before deploying.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
LOG_LEVEL=info

# ── Public URL (used for CORS + the connection snippets shown in the UI)
PUBLIC_URL=http://localhost:8080
PUBLIC_MQTT_HOST=localhost
PUBLIC_MQTT_PORT=1883
PUBLIC_MQTT_WS_PORT=8083

# ── Postgres / TimescaleDB
POSTGRES_USER=pulse
POSTGRES_PASSWORD=change_me_postgres
POSTGRES_DB=pulse
POSTGRES_PORT=5432
DATABASE_URL=postgres://pulse:change_me_postgres@postgres:5432/pulse

# ── Redis
REDIS_URL=redis://redis:6379

# ── MQTT broker (EMQX)
MQTT_URL=mqtt://emqx:1883
# EMQX rejects dashboard passwords shorter than 8 characters
EMQX_DASHBOARD_PASSWORD=pulseadmin
# Service account used by the API + ingest worker (EMQX superuser)
MQTT_BACKEND_USER=pulse-backend
MQTT_BACKEND_PASSWORD=change_me_backend

# ── Auth
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# ── API
API_PORT=4000
API_HOST=0.0.0.0

# ── Ingest tuning
INGEST_FLUSH_MS=200
INGEST_FLUSH_ROWS=500
INGEST_BURST_LIMIT=30
INGEST_BURST_WINDOW_S=3
DEVICE_OFFLINE_GRACE_MULTIPLIER=3
DEVICE_OFFLINE_MIN_GRACE_S=45

# ── Retention (default plan value; per-plan overrides live in the `plans` table)
TELEMETRY_RETENTION_DAYS=30

# ── Ports exposed on the host
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=443
EMQX_DASHBOARD_PORT=18083
EMQX_TCP_PORT=1883
EMQX_WS_PORT=8083
EMQX_TLS_PORT=8883

# ─────────────────────────────────────────────────────────────
# TLS — leave this block untouched for local development.
#
# To go live, set all five and re-run `docker compose up -d`:
#   SITE_ADDRESS       the panel hostname; Caddy then provisions a certificate
#   MQTT_SITE_ADDRESS  the MQTT hostname, so Caddy gets a certificate for it too
#   MQTT_DOMAIN        same hostname again, for the certsync sidecar
#   MQTT_TLS_ENABLED   opens mqtts on 8883 once a certificate exists
#
# Cloudflare users: the MQTT record MUST be DNS-only (grey cloud). Cloudflare's
# proxy does not carry MQTT, and a proxied record silently breaks every device.
# ─────────────────────────────────────────────────────────────
SITE_ADDRESS=:80
MQTT_SITE_ADDRESS=:8081
MQTT_DOMAIN=
MQTT_TLS_ENABLED=false
ACME_EMAIL=admin@localhost
