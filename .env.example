# ─────────────────────────────────────────────────────────────
# Pulse IoT — environment
# Copy to `.env` and change every secret before deploying.
# ─────────────────────────────────────────────────────────────

NODE_ENV=production
LOG_LEVEL=info

# ── Public URL (used for CORS + the connection snippets shown in the UI)
PUBLIC_URL=http://localhost:8080
PUBLIC_MQTT_HOST=localhost
PUBLIC_MQTT_PORT=1883
PUBLIC_MQTT_WS_PORT=8083

# ── Postgres / TimescaleDB
POSTGRES_USER=pulse
# Left empty on purpose: docker-compose declares these ${VAR:?} so the stack
# refuses to start rather than coming up with a known-default secret.
POSTGRES_PASSWORD=
POSTGRES_DB=pulse
POSTGRES_PORT=5432
REDIS_PORT=6379
# Only for running api/ingest directly on the host (`pnpm dev`). In Docker the
# connection comes from discrete PG* variables instead, because a password
# containing '/', '+' or '@' cannot survive being pasted into a URL.
# DATABASE_URL=postgres://pulse:yourpassword@localhost:5432/pulse

# ── Redis
REDIS_URL=redis://redis:6379

# ── MQTT broker (EMQX)
MQTT_URL=mqtt://emqx:1883
# EMQX rejects dashboard passwords shorter than 8 characters
EMQX_DASHBOARD_PASSWORD=
# Service account used by the API + ingest worker (EMQX superuser)
MQTT_BACKEND_USER=pulse-backend
MQTT_BACKEND_PASSWORD=

# ── Auth
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
COOKIE_SECURE=false

# ── Billing (PayPal)
# Leave empty to run with payments disabled — the platform works without them.
# Create the app at https://developer.paypal.com/dashboard/ and keep this on
# 'sandbox' until a full subscribe/cancel cycle has been proven with test money.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Filled in after the webhook is registered; signature verification needs it.
PAYPAL_WEBHOOK_ID=

# ── API
API_PORT=4000
API_HOST=0.0.0.0

# ── Ingest tuning
INGEST_FLUSH_MS=200
INGEST_FLUSH_ROWS=500
INGEST_BURST_LIMIT=30
INGEST_BURST_WINDOW_S=3
DEVICE_OFFLINE_GRACE_MULTIPLIER=3
DEVICE_OFFLINE_MIN_GRACE_S=45

# ── Retention
# Not an environment setting. Raw telemetry retention is a TimescaleDB policy set
# by migration 0002, and each plan's queryable window comes from the `plans`
# table. To change the real policy:
#   docker compose exec -T postgres psql -U pulse -d pulse #     -c "SELECT remove_retention_policy('telemetry');" #     -c "SELECT add_retention_policy('telemetry', INTERVAL '90 days');"

# ── Ports exposed on the host
CADDY_HTTP_PORT=8080
CADDY_HTTPS_PORT=443
EMQX_DASHBOARD_PORT=18083
EMQX_TCP_PORT=1883
EMQX_WS_PORT=8083
EMQX_TLS_PORT=8883

# ─────────────────────────────────────────────────────────────
# TLS — leave this block untouched for local development.
#
# To go live, set all five and re-run `docker compose up -d`:
#   SITE_ADDRESS       the panel hostname; Caddy then provisions a certificate
#   MQTT_SITE_ADDRESS  the MQTT hostname, so Caddy gets a certificate for it too
#   MQTT_DOMAIN        same hostname again, for the certsync sidecar
#   MQTT_TLS_ENABLED   opens mqtts on 8883 once a certificate exists
#
# Cloudflare users: the MQTT record MUST be DNS-only (grey cloud). Cloudflare's
# proxy does not carry MQTT, and a proxied record silently breaks every device.
# ─────────────────────────────────────────────────────────────
SITE_ADDRESS=:80
MQTT_SITE_ADDRESS=:8081
MQTT_DOMAIN=
MQTT_TLS_ENABLED=false
ACME_EMAIL=admin@localhost
